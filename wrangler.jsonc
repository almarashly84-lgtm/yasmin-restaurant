{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasmin-restaurant",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/img/*", "/r", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasmin-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "yasmin-images" }
  ],
  "vars": {
    "SHOP_TIMEZONE": "Europe/Vienna"
  }
  // Secrets (not here): ADMIN_INITIAL_PASSWORD and IP_SALT — set them in Cloudflare → Settings → Variables and Secrets
}
